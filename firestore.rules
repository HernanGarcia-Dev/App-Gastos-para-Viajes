rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ÚNICO viaje permitido. En la consola de Firebase reemplazá CODIGO_DEL_VIAJE por el ID
    // del documento de tu viaje. No lo subas al repo.
    function esElViaje(code) { return code == 'CODIGO_DEL_VIAJE'; }

    // Un gasto válido, y que cada cambio deje una entrada NUEVA en el historial con los mismos datos.
    function gastoValido(code, id, d) {
      let hp = /databases/$(database)/documents/trips/$(code)/history/$(d.h);
      return d.keys().hasOnly(['amt','desc','payer','parts','date','split','cat','del','by','at','h'])
        && d.amt is int && d.amt > 0 && d.amt <= 100000000
        && d.desc is string && d.desc.size() > 0 && d.desc.size() <= 200
        && d.payer is string && d.payer.size() <= 40
        && d.parts is list && d.parts.size() > 0 && d.parts.size() <= 20
        && d.date is number
        && (!('split' in d) || (d.split is map && d.split.size() > 0 && d.split.size() <= 20))
        && (!('cat' in d) || (d.cat is string && d.cat.size() <= 40))
        && (!('del' in d) || d.del is bool)
        && d.by is string && d.by.size() <= 40
        && d.at == request.time
        && d.h is string && d.h.size() <= 40
        && !exists(hp)
        && getAfter(hp).data.exp == id
        && getAfter(hp).data.data.amt == d.amt
        && getAfter(hp).data.data.desc == d.desc
        && getAfter(hp).data.data.payer == d.payer
        && getAfter(hp).data.data.get('del', false) == d.get('del', false);
    }

    match /trips/{code} {
      allow get: if esElViaje(code);
      allow list, create, update, delete: if false;

      match /expenses/{id} {
        allow read: if esElViaje(code);
        allow create, update: if esElViaje(code) && gastoValido(code, id, request.resource.data);
        allow delete: if false;   // nada se borra de verdad: va a la papelera
      }

      // Historial: solo se agregan entradas; nadie puede modificarlas ni borrarlas.
      match /history/{hid} {
        allow read: if esElViaje(code);
        allow create: if esElViaje(code)
          && request.resource.data.keys().hasOnly(['exp','act','data','by','at'])
          && request.resource.data.exp is string && request.resource.data.exp.size() <= 40
          && request.resource.data.act in ['save','del','restore','backup']
          && request.resource.data.data is map && request.resource.data.data.size() <= 12
          && request.resource.data.by is string && request.resource.data.by.size() <= 40
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
